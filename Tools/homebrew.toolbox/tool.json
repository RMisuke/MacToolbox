{
  "schemaVersion": 1,
  "id": "system.homebrew",
  "name": "Homebrew 管理器",
  "version": "0.2.0",
  "category": "系统",
  "icon": "shippingbox",
  "summary": "图形化管理 Homebrew 软件包、依赖、更新、自检与镜像源；同时提供 CLI/Agent 入口。",
  "agent": {
    "capability": "system.homebrew",
    "description": "Homebrew 的 CLI 入口：状态、搜索、信息、列出、可更新、安装、卸载、升级、doctor、update、cleanup；修改类操作默认需要 allowMutations=true。",
    "stability": "experimental",
    "readOnly": false,
    "idempotent": false,
    "timeoutSec": 1800,
    "checkpoint": "never",
    "tags": [
      "system",
      "package",
      "homebrew",
      "brew"
    ],
    "outputs": [
      "json",
      "text"
    ],
    "examples": [
      {
        "title": "查看可更新",
        "inputs": {
          "action": "outdated"
        }
      },
      {
        "title": "搜索 ffmpeg",
        "inputs": {
          "action": "search",
          "package": "ffmpeg"
        }
      },
      {
        "title": "安装 cask（显式允许修改）",
        "inputs": {
          "action": "install",
          "package": "rectangle",
          "cask": true,
          "allowMutations": true
        }
      }
    ]
  },
  "nativeView": "homebrew",
  "requirements": [
    {
      "kind": "cli",
      "name": "brew",
      "installHint": "https://brew.sh"
    }
  ],
  "inputs": [
    {
      "key": "action",
      "type": "select",
      "label": "操作",
      "default": "status",
      "group": "基础",
      "options": [
        {
          "value": "status",
          "label": "状态与版本"
        },
        {
          "value": "outdated",
          "label": "可更新列表"
        },
        {
          "value": "list",
          "label": "已安装列表"
        },
        {
          "value": "search",
          "label": "搜索软件包"
        },
        {
          "value": "info",
          "label": "查看软件包信息"
        },
        {
          "value": "install",
          "label": "安装"
        },
        {
          "value": "uninstall",
          "label": "卸载"
        },
        {
          "value": "upgrade",
          "label": "升级"
        },
        {
          "value": "doctor",
          "label": "brew doctor"
        },
        {
          "value": "update",
          "label": "brew update"
        },
        {
          "value": "cleanup",
          "label": "brew cleanup"
        }
      ],
      "help": "读取类操作直接执行；install/uninstall/upgrade/update/cleanup 需要 allowMutations=true。"
    },
    {
      "key": "package",
      "type": "text",
      "label": "软件包",
      "default": "",
      "group": "基础",
      "help": "search/info/install/uninstall/upgrade 使用的 formula 或 cask 名；upgrade 留空表示全部。"
    },
    {
      "key": "cask",
      "type": "toggle",
      "label": "按 Cask 处理",
      "default": false,
      "group": "基础",
      "help": "install/uninstall/info 时使用 --cask。"
    },
    {
      "key": "allowMutations",
      "type": "toggle",
      "label": "允许修改系统",
      "default": false,
      "group": "安全",
      "help": "默认关闭；只有显式打开才会执行安装、卸载、升级、update、cleanup。"
    },
    {
      "key": "outputDir",
      "type": "directory",
      "label": "输出目录",
      "default": "",
      "group": "输出",
      "help": "留空写入任务目录；选择目录则把 JSON/TXT 结果也复制过去。"
    }
  ],
  "quick": {
    "title": "查看 Homebrew 状态",
    "inputs": [
      "action",
      "package"
    ]
  },
  "resources": [
    "network"
  ],
  "run": {
    "command": "/usr/bin/env",
    "args": [
      "python3",
      "{{toolDir}}/scripts/tool.py",
      "run",
      "--config",
      "{{configFile}}"
    ]
  },
  "doctor": {
    "command": "/usr/bin/env",
    "args": [
      "python3",
      "{{toolDir}}/scripts/tool.py",
      "doctor",
      "--config",
      "{{configFile}}"
    ]
  },
  "setup": {
    "command": "/usr/bin/env",
    "args": [
      "python3",
      "{{toolDir}}/scripts/tool.py",
      "setup",
      "--config",
      "{{configFile}}"
    ]
  }
}
